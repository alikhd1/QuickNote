{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickNote",
  "version": "1.0.0",
  "identifier": "com.quicknote.portable",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "QuickNote",
        "width": 1150,
        "height": 760,
        "minWidth": 700,
        "minHeight": 460,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
